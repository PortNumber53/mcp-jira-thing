# Backend HTTP server
BACKEND_ADDR=:18111

# Primary database used by the backend.
# This should point at your Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/mcp_jira_thing?sslmode=disable

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session/cookie signing
COOKIE_SECRET=
# Optional dedicated credential for the Node MCP service's internal session
# API. Defaults to COOKIE_SECRET when omitted.
MCP_SESSION_API_TOKEN=
COOKIE_DOMAIN=.example.com
FRONTEND_URL=https://example.com
BACKEND_URL=https://api.example.com
