MCP_SERVER_PORT=3001
BACKEND_BASE_URL=http://localhost:18111

# Must match backend MCP_SESSION_API_TOKEN. Both services fall back to their
# shared SESSION_SECRET/COOKIE_SECRET when this is omitted.
MCP_SESSION_API_TOKEN=
SESSION_SECRET=

# Sliding lifetime for PostgreSQL-backed transport sessions (default: 86400).
MCP_SESSION_TTL_SECONDS=86400

LOG_LEVEL=info
